{
  "invoice_patterns": [
    {"name": "Invoice AlphaNumeric", "regex": "[A-Z]{1,3}\\d{6,20}"},
    {"name": "Invoice Slash", "regex": "[A-Z]{2}\\d{4}/\\d{4}"},
    {"name": "Invoice Dash", "regex": "\\d{2}-\\d{6}"},
    {"name": "IG Invoice", "regex": "IG\\d{3,6}[/-]\\d{3,5}"}
  ],
  "vendor_branch_patterns": [
    {"name": "Thai Vendor Branch", "regex": "สาขา(?:ที่|เลขที่)?\\s*[:：#-]?\\s*(\\d{1,10})"},
    {"name": "English Vendor Branch", "regex": "Branch\\s*(?:No\\.?|Number|Code|ID)?\\s*[:：#-]?\\s*(\\d{1,10})"}
  ],
  "vendor_issuer_patterns": [
    {"name": "Thai Tax Invoice Issued By", "regex": "ใบกำกับภาษี\\s*ออกโดย"},
    {"name": "Thai Document Issued By", "regex": "เอกสาร\\s*ออกโดย"},
    {"name": "Thai Issued By", "regex": "ออกโดย\\s*[:：]?"},
    {"name": "English Issued By", "regex": "\\bISSUED\\s+BY\\b"},
    {"name": "English Invoice Issued By", "regex": "\\bINVOICE\\s+ISSUED\\s+BY\\b"}
  ],
  "customer_branch_patterns": [
    {"name": "Thai Customer Branch", "regex": "สาขา(?:ที่|เลขที่)?\\s*[:：#-]?\\s*(\\d{1,10})"},
    {"name": "English Customer Branch", "regex": "Branch\\s*(?:No\\.?|Number|Code|ID)?\\s*[:：#-]?\\s*(\\d{1,10})"}
  ],
  "taxid_patterns": [
    {"name": "Thai TaxID", "regex": "เลขประจำตัวผู้เสียภาษี.*?([0-9OIl\\s\\-]{13,30})"},
    {"name": "English TaxID", "regex": "TAX\\s*ID.*?([0-9OIl\\s\\-]{13,30})"},
    {"name": "TIN", "regex": "TIN.*?([0-9OIl\\s\\-]{13,30})"}
  ],
  "exclude_tax_ids": ["0105529030059"],
  "stop_keywords": [
    "BILL TO", "SHIP TO", "Customer", "Customer Name", "Customer Code",
    "ชื่อลูกค้า", "รหัสลูกค้า", "Delivery To", "ส่งของที่"
  ]
}
